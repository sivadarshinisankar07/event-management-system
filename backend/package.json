{
  "name": "campus-events-backend",
  "version": "1.0.0",
  "description": "Node.js + Express + MySQL REST API for CampusEvents",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "nodemon --env-file=.env server.js",
